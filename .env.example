# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-secure-password
POSTGRES_DB=SoftLearn_development

# Application Secrets
JWT_SECRET=change-this-to-a-secure-random-string-minimum-32-characters
RAILS_MASTER_KEY=

# Database URL for Rails
DATABASE_URL=postgresql://postgres:change-this-secure-password@postgres:5432/SoftLearn_development

# Environment
RAILS_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend API URL
VITE_API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Gmail SMTP Configuration (for password reset emails)
GMAIL_USERNAME=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-digit-app-password
